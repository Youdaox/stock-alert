NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stock_alert
HOST=127.0.0.1
PORT=3100
# The scheduler ticks this often; per-source minIntervalSeconds decides what actually runs.
CRON_SCHEDULE=* * * * *
HTTP_USER_AGENT=stock-alert-bot/0.1 (+https://github.com/Youdaox/stock-alert)
HTTP_DELAY_MS=200
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_MS=500
HTTP_TIMEOUT_MS=20000
RESTOCK_ALERT_COOLDOWN_HOURS=6
DISCORD_WEBHOOK_URL=
# Phone push. Install the ntfy app, subscribe to a topic nobody could guess, and put its URL here.
# Anyone who knows a public ntfy.sh topic name can read it, so treat this like a password.
NTFY_TOPIC_URL=
